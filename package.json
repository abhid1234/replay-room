{
  "name": "@avee1234/replay-room",
  "version": "0.1.0",
  "private": false,
  "description": "Guarded webhook rehearsal, replay evidence, and incident operations for Render.",
  "keywords": [
    "webhooks",
    "dead-letter-queue",
    "incident-response",
    "render",
    "replay",
    "observability"
  ],
  "homepage": "https://github.com/abhid1234/replay-room#readme",
  "bugs": {
    "url": "https://github.com/abhid1234/replay-room/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhid1234/replay-room.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "replay-room": "./dist/cli/verify-evidence.js"
  },
  "files": [
    "dist/",
    "docs/",
    "fixtures/",
    "schema/",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "dev:web": "npm --workspace web run dev",
    "build": "tsc -p tsconfig.build.json && npm --workspace web run build",
    "start:api": "node dist/api/server.js",
    "start:worker": "node dist/worker.js",
    "start:cron": "node dist/cron.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "evidence:verify": "tsx src/cli/verify-evidence.ts verify",
    "evidence:inspect": "tsx src/cli/verify-evidence.ts inspect",
    "test": "vitest run",
    "test:integration": "INTEGRATION_TESTS=true vitest run tests/integration.test.ts",
    "test:smoke": "node --test scripts/check-live-deployment.node-test.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "conformance": "node scripts/check-conformance.mjs",
    "test:package": "node --test scripts/check-registry-version.node-test.mjs && node scripts/check-package.mjs",
    "smoke:live": "node scripts/check-live-deployment.mjs",
    "verify": "npm run typecheck && npm test && npm run test:smoke && npm run build && npm run conformance && npm run test:package",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "11.2.0",
    "bullmq": "6.3.9",
    "fastify": "5.12.5",
    "ioredis": "6.0.0",
    "pg": "8.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
